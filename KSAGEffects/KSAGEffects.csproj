<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\tooling\msbuild\KsaMod.props" />

	<PropertyGroup>
		<ModName>KSAGEffects</ModName>
		<Configurations>Debug;Release;PerfDebug</Configurations>

		<VersionPrefix>0.3.3</VersionPrefix>
		<AssemblyVersion>0.3.0.0</AssemblyVersion>

		<Company>AMPW</Company>
		<Authors>AMPW</Authors>
		<Copyright>GNU GPL v3.0</Copyright>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='PerfDebug'">
		<DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
		<InformationalVersionPostfix>-perfDebug</InformationalVersionPostfix>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\GEffectsLogic\GEffectsLogic\GEffectsLogic.csproj" />
		<Reference Include="KittenExtensions">
			<HintPath>$(KSAModsDir)KittenExtensionsContinued/KittenExtensions.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="ShaderExtensions">
			<HintPath>$(KSAModsDir)ShaderExtensions/ShaderExtensions.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<StarMapModDependency Include="KittenExtensionsContinued">
			<ImportedAssemblies>KittenExtensions</ImportedAssemblies>
		</StarMapModDependency>
		<StarMapModDependency Include="ShaderExtensions">
			<ImportedAssemblies>ShaderExtensions</ImportedAssemblies>
		</StarMapModDependency>
	</ItemGroup>

	<ItemGroup>
		<None Update="GEffectAssests.xml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<ModManifestArray>assets</ModManifestArray>
		</None>
		<None Update="Shaders\**\*.*">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Patches\**\*.*">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Patches\EnhancedEngine.xml">
			<ModManifestArray>patches</ModManifestArray>
		</None>
	</ItemGroup>

	<Import Project="..\tooling\msbuild\KsaMod.targets" />
</Project>
